<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TodoList"
             Title="TodoList"
             BackgroundColor="DarkGray"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="80, *, 70" Padding="0,0,0,10">

        <Grid BackgroundColor="#444444"
              Margin="0"
              ColumnDefinitions="*, 10"
              RowDefinitions="*, 10"
              Padding="10,8,5,0">
            <Label HorizontalOptions="Start" Text="ToDo List"
                   VerticalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="40"
                   Padding="40,3,0,0"
                   Margin="0,0,0,10"
                   />
            <Image HorizontalOptions="End" Source="user_icon_svgrepo.svg"
                WidthRequest="40"
                HeightRequest="35" 
                />

        </Grid>

        <ListView x:Name="taskLV" Grid.Row="1" RowHeight="80">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell Height="0">
                        <Grid Padding="10"
                              ColumnDefinitions="*, Auto, Auto"
                              HeightRequest="80"
                              >
                            <Border
                                   Padding="10"
                                   Margin="0,5"
                                   BackgroundColor="White"
                                   StrokeShape="RoundRectangle 10">
                                <Label Text="{Binding item_name}"
                                VerticalOptions="Fill"
                                FontSize="18"
                                TextColor="Black"
                                       />
                            </Border>

                            <Image Source="trash_svgrepo.svg" Grid.Column="1"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   WidthRequest="25"
                                   HeightRequest="25"
                                   Margin="10,0,5,0">
                                
                                
                                
                            </Image>

                            <Image Source="check_svgrepo.png" Grid.Column="2"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   WidthRequest="25"
                                   HeightRequest="25"
                                   Margin="10,0,5,0"
                                   >
                                <!--
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Tap_Delete"/>
                                </Image.GestureRecognizers> -->
                            </Image>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <VerticalStackLayout Grid.Row="2" Padding="10" Margin="0,0,10,0">
            <Button HorizontalOptions="End" BackgroundColor="Gold"
                Padding="5"
                WidthRequest="120"
                HeightRequest="50"
                Text="Add Task  +"
                FontAttributes="Bold"
                FontSize="15"
                />

        </VerticalStackLayout>

    </Grid>
</ContentPage>