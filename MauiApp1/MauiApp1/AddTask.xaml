<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.AddTask"
             Title="Add New Task"
             BackgroundColor="DimGray"
             Shell.NavBarIsVisible="False"
             >

    <Grid RowDefinitions="80, *, 70" Padding="0,0,0,10">

        <Grid BackgroundColor="#444444"
      Margin="0"
      ColumnDefinitions="*, 10"
      RowDefinitions="*, 10"
      Padding="10,8,5,0">
            <Label HorizontalOptions="Start" Text="Add Task"
           VerticalOptions="Center"
           FontAttributes="Bold"
           FontSize="40"
           Padding="40,3,0,0"
           Margin="0,0,0,10"
            TextColor="White"
           />
            <Image HorizontalOptions="End" Source="user_icon_svgrepo.svg"
                WidthRequest="40"
                HeightRequest="35">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUserIconTapped" />
                </Image.GestureRecognizers>
            </Image>

        </Grid>

        <Grid Grid.Row="1" Padding="20" RowDefinitions="Auto, Auto, Auto" RowSpacing="10">

            <Border Grid.Row="0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 10"
            Padding="10"
            HorizontalOptions="Start"
            WidthRequest="300">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Opacity="0.2" />
                </Border.Shadow>
                <Entry x:Name="taskTitleEntry"
                       Placeholder="Task Title" FontSize="18"
                       TextColor="Black"/>
            </Border>

            <ScrollView Grid.Row="2"
                HeightRequest="360">
                <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 10"
                Padding="10"
                Margin="0,5,0,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="2,2" Opacity="0.2" />
                    </Border.Shadow>
                    <Editor x:Name="taskDescEditor"
                    Placeholder="Description"
                    FontSize="18"
                    AutoSize="TextChanges"
                    HeightRequest="330"
                    TextColor="Black"/>
                </Border>
            </ScrollView>

        </Grid>

        <VerticalStackLayout Grid.Row="2" Padding="10" Margin="0,0,10,0" HeightRequest="145" VerticalOptions="Center">
            <Grid RowDefinitions="*" ColumnDefinitions="50*, 50*">
                <Button BackgroundColor="Gold"
                Padding="5"
                HeightRequest="50"
                WidthRequest="130"
                Text="Add Task  +"
                FontAttributes="Bold"
                FontSize="16"
                Clicked="OnAddTaskClicked"
                Grid.Column="1"
                />

                <Button BackgroundColor="Gold"
                Padding="5"
                HeightRequest="50"
                WidthRequest="130"
                Text="Cancel"
                FontAttributes="Bold"
                FontSize="16"
                Clicked="OnClickedCancel"
                Grid.Column="0"/>
            </Grid>
        </VerticalStackLayout>

        <Grid x:Name="userPopup"
          IsVisible="False"
          BackgroundColor="#80000000"
          Grid.RowSpan="3"
          HorizontalOptions="FillAndExpand"
          VerticalOptions="FillAndExpand"
          ZIndex="99">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUserPopupBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Frame BackgroundColor="Transparent"
               CornerRadius="15"
               Padding="20"
               WidthRequest="300"
               HeightRequest="340"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               BorderColor="Transparent"
               HasShadow="False">

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="bingus.jpg"
                       WidthRequest="200"
                       HeightRequest="180"
                       Aspect="AspectFill"
                       HorizontalOptions="Center" />

                    <Button Text="Sign Out"
                        FontAttributes="Bold"
                        FontSize="18"
                        BackgroundColor="Gold"
                        TextColor="Black"
                        WidthRequest="200"
                        Clicked="OnSignOutClicked"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
